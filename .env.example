# ==============================================================================
# BookTrack Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename the copy to '.env'
# 2. Fill in your actual MongoDB connection string below
# 3. NEVER commit your actual '.env' file to GitHub!
# ==============================================================================

# Port the Express server will listen on (Render automatically provides PORT in production)
PORT=5000

# ------------------------------------------------------------------------------
# MongoDB Connection String
# ------------------------------------------------------------------------------
# OPTION 1: MongoDB Atlas (Cloud - Required for Render deployment)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Note: If your password contains special characters like '@', ':', or '%', URL-encode them.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/booktrack?retryWrites=true&w=majority

# OPTION 2: Local MongoDB Community Server (for local offline development)
# Uncomment the line below if you are running MongoDB locally:
# MONGODB_URI=mongodb://127.0.0.1:27017/booktrack
